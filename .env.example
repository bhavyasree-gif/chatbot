# Copy to .env and edit if your MongoDB is not on localhost.
MONGO_URI=mongodb://127.0.0.1:27017/
DATABASE_NAME=ctiSentinelDB

# LOCAL DEVELOPMENT ONLY. Enables assignment runner endpoints.
ENABLE_LAB_RUNNER=0
# Optional isolated replica set for Chapter 10 and synthetic Chapter 11 data.
MONGO_LABS_URI=mongodb://127.0.0.1:27019/?directConnection=true
# Optional Chapter 12 TLS test instance (no credentials committed).
# MONGO_TLS_URI=mongodb://127.0.0.1:27100/?directConnection=true
# MONGO_TLS_CA_FILE=C:/path/to/ca.crt

# Ollama runs locally; no API key needed.
# Install Ollama for Windows and run: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Set AI_PROVIDER=openai to use the server-side OpenAI API.
AI_PROVIDER=ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional read-only Windows security checks. Requires native Windows backend.
ENABLE_HOST_SCAN=0
